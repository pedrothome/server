COMPOSE_PROFILES=
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:adguardhome/docker-compose.yml:tandoor/docker-compose.yml:joplin/docker-compose.yml:homeassistant/docker-compose.yml:immich/docker-compose.yml:vaultwarden/docker-compose.yml:privoxy/docker-compose.yml:paperless/docker-compose.yml
USER_ID=1000
GROUP_ID=1000
TIMEZONE="America/New_York"
CONFIG_ROOT="."
DATA_ROOT="/mnt/data"
DOWNLOAD_ROOT="/mnt/data/torrents"
IMMICH_UPLOAD_LOCATION="/mnt/data/photos"
PIA_LOCATION=ca
PIA_USER=
PIA_PASS=
PIA_LOCAL_NETWORK="192.168.0.0/16"
HOSTNAME=localhost
BASE_HOSTNAME=localhost
# Base domain used for externally-exposed apps (via Cloudflare tunnel). Keep it single-level
# (the zone apex) so app URLs like milhas.example.com are covered by free Universal SSL.
EXTERNAL_HOSTNAME=example.com
HOMEASSISTANT_HOSTNAME="homeassistant.${BASE_HOSTNAME}"
IMMICH_HOSTNAME=
ADGUARD_HOSTNAME="dns.${BASE_HOSTNAME}"
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
DNS_CHALLENGE=true
DNS_CHALLENGE_PROVIDER=cloudflare
LETS_ENCRYPT_CA_SERVER="https://acme-v02.api.letsencrypt.org/directory"
LETS_ENCRYPT_EMAIL=
CLOUDFLARE_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_ZONE_API_TOKEN=
# --- External access via Cloudflare Tunnel + Google forward-auth ---
# Token from Cloudflare Zero Trust -> Networks -> Tunnels (leave empty to disable the tunnel).
CLOUDFLARE_TUNNEL_TOKEN=
# Google OAuth client; authorized redirect URI: https://auth.<EXTERNAL_HOSTNAME>/_oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cookie signing secret (openssl rand -hex 24)
FORWARD_AUTH_SECRET=
# Comma-separated allow-list of Google e-mails permitted through the tunnel
FORWARD_AUTH_WHITELIST=
# OAuth callback host (must be routed through the tunnel)
FORWARD_AUTH_HOSTNAME="auth.${EXTERNAL_HOSTNAME}"
# error-pages theme (ghost, l7-dark, matrix, shuffle, ...)
ERROR_PAGES_TEMPLATE=ghost
# External hostnames for the apps you choose to expose (single-level under EXTERNAL_HOSTNAME)
DND_EXTERNAL_HOSTNAME="5etools.${EXTERNAL_HOSTNAME}"
MILHAS_EXTERNAL_HOSTNAME="milhas.${EXTERNAL_HOSTNAME}"
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
SEERR_API_KEY=
SABNZBD_API_KEY=
IMMICH_API_KEY=
AUTOBRR_API_KEY=
HOMEASSISTANT_ACCESS_TOKEN=
HOMEPAGE_VAR_TITLE="Docker-Compose NAS"
HOMEPAGE_VAR_SEARCH_PROVIDER=google
HOMEPAGE_VAR_HEADER_STYLE=boxed
HOMEPAGE_VAR_WEATHER_CITY=
HOMEPAGE_VAR_WEATHER_LAT=
HOMEPAGE_VAR_WEATHER_LONG=
HOMEPAGE_VAR_WEATHER_UNIT=metric
IMMICH_DB_PASSWORD=postgres
CALIBRE_USERNAME=admin
CALIBRE_PASSWORD=admin123
SEERR_HOSTNAME="seerr.${BASE_HOSTNAME}"
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
